<!-- Firebase (compat SDK, CDN, no build step needed) -->
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore-compat.js"></script>
<script>
// ====== FILL THIS IN with your own Firebase project's config ======
// Firebase console > Project settings > General > Your apps > SDK setup and configuration
const firebaseConfig = {
  apiKey: "AIzaSyB0FmI22-qyJGFMfJnATt-ejWyOkWm2WRY",
  authDomain: "expense-splitter-6b118.firebaseapp.com",
  projectId: "expense-splitter-6b118",
  storageBucket: "expense-splitter-6b118.firebasestorage.app",
  messagingSenderId: "442132567705",
  appId: "1:442132567705:web:2bd77fc8b21357280a0a08"
};
// =====================================================================

const PEOPLE = ["Ben", "Laurie", "Michael", "Matt"];
let expenses = [];
let colRef = null;

const payerSel = document.getElementById('payer');
const splitRow = document.getElementById('splitRow');
const selectedSplit = new Set(PEOPLE);
const statusEl = document.getElementById('status');

PEOPLE.forEach(p => {
  const o = document.createElement('option');
  o.value = p; o.textContent = p;
  payerSel.appendChild(o);
});

PEOPLE.forEach(p => {
  const chip = document.createElement('div');
  chip.className = 'chip active';
  chip.textContent = p;
  chip.addEventListener('click', () => {
    if (selectedSplit.has(p)) {
      if (selectedSplit.size > 1) { selectedSplit.delete(p); chip.classList.remove('active'); }
    } else {
      selectedSplit.add(p); chip.classList.add('active');
    }
  });
  splitRow.appendChild(chip);
});

function fmt(n) {
  const sign = n < 0 ? '-' : '';
  return sign + '£' + Math.abs(n).toFixed(2);
}
function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function render() {
  const list = document.getElementById('expenseList');
  if (!expenses.length) {
    list.innerHTML = '<div class="empty">No expenses yet</div>';
  } else {
    const sorted = [...expenses].sort((a,b) => (b.createdAt||0) - (a.createdAt||0));
    list.innerHTML = sorted.map(e => `
      <div class="expense">
        <div>
          <div>${escapeHtml(e.description || 'Expense')}</div>
          <div class="meta">${e.payer} paid · split ${e.splitAmong.join(', ')}</div>
        </div>
        <div style="text-align:right">
          <div class="amt">${fmt(e.amount)}</div>
          <button class="del" data-id="${e.id}">remove</button>
        </div>
      </div>
    `).join('');
    list.querySelectorAll('.del').forEach(btn => {
      btn.addEventListener('click', () => removeExpense(btn.dataset.id));
    });
  }

  const balances = {};
  PEOPLE.forEach(p => balances[p] = 0);
  expenses.forEach(e => {
    const share = e.amount / e.splitAmong.length;
    balances[e.payer] = (balances[e.payer] || 0) + e.amount;
    e.splitAmong.forEach(p => { balances[p] = (balances[p] || 0) - share; });
  });

  const balDiv = document.getElementById('balances');
  if (!expenses.length) {
    balDiv.innerHTML = '<div class="empty">Add an expense to see balances</div>';
  } else {
    balDiv.innerHTML = PEOPLE.map(p => {
      const v = balances[p];
      const color = v > 0.005 ? 'var(--pos)' : (v < -0.005 ? 'var(--neg)' : 'var(--text-dim)');
      const label = v > 0.005 ? 'is owed' : (v < -0.005 ? 'owes' : 'is settled');
      return `<div class="balance-row"><span>${p}</span><span style="color:${color}">${label} ${fmt(Math.abs(v))}</span></div>`;
    }).join('');
  }

  const settleDiv = document.getElementById('settlement');
  const debtors = [], creditors = [];
  PEOPLE.forEach(p => {
    const v = Math.round(balances[p] * 100) / 100;
    if (v < -0.005) debtors.push({p, v: -v});
    else if (v > 0.005) creditors.push({p, v});
  });
  const txns = [];
  let di = 0, ci = 0;
  debtors.sort((a,b)=>b.v-a.v); creditors.sort((a,b)=>b.v-a.v);
  while (di < debtors.length && ci < creditors.length) {
    const d = debtors[di], c = creditors[ci];
    const amt = Math.min(d.v, c.v);
    if (amt > 0.005) txns.push({from: d.p, to: c.p, amt});
    d.v -= amt; c.v -= amt;
    if (d.v <= 0.005) di++;
    if (c.v <= 0.005) ci++;
  }
  settleDiv.innerHTML = txns.length
    ? txns.map(t => `<div class="settle-line"><strong>${t.from}</strong> owes <strong>${t.to}</strong> ${fmt(t.amt)}</div>`).join('')
    : '<div class="empty">Everyone is settled up</div>';
}

async function removeExpense(id) {
  if (!colRef) return;
  try { await colRef.doc(id).delete(); }
  catch (err) { statusEl.textContent = 'Could not remove — check your connection.'; }
}

document.getElementById('addBtn').addEventListener('click', async () => {
  const desc = document.getElementById('desc').value.trim();
  const amount = parseFloat(document.getElementById('amount').value);
  const payer = payerSel.value;
  const split = PEOPLE.filter(p => selectedSplit.has(p));

  if (!amount || amount <= 0) { statusEl.textContent = 'Enter a valid amount.'; return; }
  if (!split.length) { statusEl.textContent = 'Pick at least one person to split with.'; return; }
  if (!colRef) { statusEl.textContent = 'Not connected to Firebase yet.'; return; }

  try {
    await colRef.add({ description: desc, amount, payer, splitAmong: split, createdAt: Date.now() });
    document.getElementById('desc').value = '';
    document.getElementById('amount').value = '';
    statusEl.textContent = '';
  } catch (err) {
    statusEl.textContent = 'Could not save — check your Firebase config and rules.';
  }
});

function init() {
  try {
    const app = firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();
    colRef = db.collection('expenses');
    colRef.onSnapshot(
      (snap) => {
        expenses = snap.docs.map(d => ({ id: d.id, ...d.data() }));
        statusEl.textContent = '';
        render();
      },
      (err) => {
        statusEl.textContent = 'Connection error — check your Firebase config and Firestore rules.';
        console.error(err);
      }
    );
  } catch (err) {
    statusEl.textContent = 'Firebase not configured yet — edit firebaseConfig in the code.';
    console.error(err);
    render();
  }
}

init();
</script>
</body>
</html>
