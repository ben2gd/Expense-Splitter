  <h1>🧾 Trip Expenses</h1>
  <div class="sub">Laurie, Michael, Matt &amp; Ben — log spend, split it, settle up.</div>

  <div class="card">
    <h2>Add an expense</h2>
    <label>What was it?</label>
    <input type="text" id="desc" placeholder="e.g. Taxi to hotel">
    <label>Amount (£)</label>
    <input type="number" id="amount" placeholder="0.00" step="0.01" min="0">
    <label>Who paid?</label>
    <select id="payer"></select>
    <label>Split between</label>
    <div class="split-row" id="splitRow"></div>
    <button class="btn-primary" id="addBtn">Add expense</button>
    <div class="status" id="status">Connecting…</div>
  </div>

  <div class="card">
    <h2>Expenses</h2>
    <div id="expenseList"><div class="empty">No expenses yet</div></div>
  </div>

  <div class="card">
    <h2>Balances</h2>
    <div id="balances"><div class="empty">Add an expense to see balances</div></div>
